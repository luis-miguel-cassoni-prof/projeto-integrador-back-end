{
  "info": {
    "_postman_id": "8361041c-61b2-42c1-9e31-98fe97ae313b",
    "name": "Projeto Integrador · Evidências da API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59185172",
    "_collection_link": "https://go.postman.co/collection/59185172-8361041c-61b2-42c1-9e31-98fe97ae313b?source=collection_link",
    "description": "Execute toda a coleção em ordem no Collection Runner com cookies habilitados, em banco de teste com ao menos um local. Ajuste baseUrl. As variáveis temporárias valem durante a execução. Cada rodada cria uma conta de teste que permanece no banco. A limpeza exclui a publicação e os contatos gerados. O último grupo usa adminEmail e adminSenha do ambiente, se fornecidos. Exporte os resultados do Runner para guardar as evidências reais."
  },
  "item": [
    {
      "name": "01 · Cadastro e sessão",
      "item": [
        {
          "name": "Obter CSRF e preparar a execução",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuario/autenticacao/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "autenticacao",
                "csrf"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.variables.replaceIn(\"{{$guid}}\").slice(0, 18);",
                  "pm.variables.set(\"run\", run);",
                  "pm.variables.set(\"emailTeste\", \"pi.\" + run + \"@unifio.edu.br\");",
                  "pm.variables.set(\"senhaTeste\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Obter CSRF e preparar a execução\", () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(data.headerName).to.be.a(\"string\").and.not.empty;",
                  "  pm.variables.set(\"csrfHeader\", data.headerName);",
                  "  pm.variables.set(\"csrfToken\", data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar usuário de teste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuario/autenticacao/cadastrar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "autenticacao",
                "cadastrar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Evidência {{run}}\",\n  \"email\": \"{{emailTeste}}\",\n  \"senha\": \"{{senhaTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Cadastrar usuário de teste\", () => {",
                  "  pm.expect(pm.response.code).to.equal(201);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.idUsuario).to.be.a(\"number\").above(0);",
                  "  pm.variables.set(\"idUsuario\", data.idUsuario);",
                  "  pm.expect(data.permissao).to.equal(\"USUARIO\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrar com a conta criada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "{{csrfHeader}}",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuario/autenticacao/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "autenticacao",
                "login"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{emailTeste}}",
                  "type": "text"
                },
                {
                  "key": "senha",
                  "value": "{{senhaTeste}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar CSRF após o login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuario/autenticacao/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "autenticacao",
                "csrf"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Renovar CSRF após o login\", () => {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(data.headerName).to.be.a(\"string\").and.not.empty;",
                  "  pm.variables.set(\"csrfHeader\", data.headerName);",
                  "  pm.variables.set(\"csrfToken\", data.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
